# -*- coding: utf-8 -*-
"""
A股数据管理器
"""
import pandas as pd
import numpy as np
from typing import Dict, List, Optional, Any
from datetime import datetime, timedelta
from loguru import logger

from .base import AStockDataFeed, BarData
from .tushare_data import TushareData, tushare_data
from .akshare_data import AKShareData, akshare_data
from .local_test_data import LocalTestData, local_test_data
from .cache import DataCache, data_cache
from .utils import stock_utils
from ..utils.config import config_manager


class AStockDataManager:
    """A股数据管理器：统一管理A股数据源和数据缓存"""
    
    def __init__(self, data_source: str = None, use_test_data: bool = False):
        """初始化A股数据管理器
        
        Args:
            data_source: 数据源名称，默认为配置中的data.source
            use_test_data: 是否使用测试数据（当网络不可用时）
        """
        if data_source is None:
            data_source = config_manager.get('data.source', 'akshare')
        
        self.data_source = data_source
        self.use_test_data = use_test_data or config_manager.get('system.mode') == 'test'
        self.data_feeds: Dict[str, AStockDataFeed] = {}
        self.cache = data_cache
        
        if not self.use_test_data:
            self._init_data_feeds()
        else:
            logger.warning("使用本地测试数据模式")
    
    def _init_data_feeds(self):
        """初始化数据源"""
        # 注册可用的数据源
        if self.data_source == 'tushare':
            self.data_feeds['tushare'] = TushareData()
            logger.info("已初始化 Tushare 数据源")
        elif self.data_source == 'akshare':
            timeout = config_manager.get('data.akshare.timeout', 30)
            self.data_feeds['akshare'] = AKShareData(timeout=timeout)
            logger.info(f"已初始化 AKShare 数据源，超时时间: {timeout}秒")
        else:
            # 默认使用akshare（免费）
            self.data_source = 'akshare'
            timeout = config_manager.get('data.akshare.timeout', 30)
            self.data_feeds['akshare'] = AKShareData(timeout=timeout)
            logger.info(f"已初始化 AKShare 数据源（默认），超时时间: {timeout}秒")
        
        # 连接数据源
        for name, feed in self.data_feeds.items():
            try:
                feed.connect()
                logger.info(f"数据源 '{name}' 连接成功")
            except Exception as e:
                logger.error(f"数据源 '{name}' 连接失败: {e}")
                self.use_test_data = True
                logger.warning("网络数据源失败，切换到测试数据模式")
    
    def get_data_feed(self, name: str = None) -> Optional[AStockDataFeed]:
        """获取数据源实例
        
        Args:
            name: 数据源名称，默认为主数据源
            
        Returns:
            数据源实例
        """
        if self.use_test_data:
            return None
        
        if name is None:
            name = self.data_source
        
        return self.data_feeds.get(name)
    
    def get_daily_data(
        self,
        symbol: str,
        start_date: str = None,
        end_date: str = None,
        adjust: str = "qfq",
        use_cache: bool = True,
        cache_ttl: int = 3600,
        fallback_to_test: bool = True
    ) -> pd.DataFrame:
        """获取A股日线数据（带缓存）
        
        Args:
            symbol: 股票代码
            start_date: 开始日期，默认为配置中的start_date
            end_date: 结束日期，默认为配置中的end_date
            adjust: 复权类型
            use_cache: 是否使用缓存
            cache_ttl: 缓存存活时间（秒）
            fallback_to_test: 网络失败时是否回退到测试数据
            
        Returns:
            日线数据DataFrame
        """
        # 使用默认日期
        if start_date is None:
            start_date = config_manager.get('data.start_date', '2020-01-01')
        if end_date is None:
            end_date = config_manager.get('data.end_date', datetime.now().strftime('%Y-%m-%d'))
        
        # 标准化股票代码
        normalized_symbol, _ = stock_utils.normalize_symbol(symbol)
        
        # 生成缓存参数
        cache_params = {
            'symbol': normalized_symbol,
            'start_date': start_date,
            'end_date': end_date,
            'adjust': adjust
        }
        
        # 尝试从缓存获取
        if use_cache and not self.use_test_data:
            cached_data = self.cache.get('daily', **cache_params)
            if cached_data is not None:
                logger.info(f"从缓存获取 {normalized_symbol} 日线数据")
                return cached_data
        
        # 如果使用测试数据
        if self.use_test_data:
            logger.info(f"使用测试数据模式获取 {normalized_symbol}")
            return self._get_test_data(normalized_symbol, start_date, end_date)
        
        # 从数据源获取
        data_feed = self.get_data_feed()
        if data_feed is None:
            if fallback_to_test:
                logger.warning(f"数据源不可用，回退到测试数据")
                return self._get_test_data(normalized_symbol, start_date, end_date)
            else:
                raise ValueError(f"未找到数据源: {self.data_source}")
        
        try:
            data = data_feed.get_daily_data(normalized_symbol, start_date, end_date, adjust)
            
            if data.empty and fallback_to_test:
                logger.warning(f"网络数据获取失败，回退到测试数据")
                return self._get_test_data(normalized_symbol, start_date, end_date)
            
            if not data.empty:
                # 验证和清理数据
                if self.validate_data(data):
                    data = self.clean_data(data)
                    
                    # 缓存数据
                    if use_cache:
                        self.cache.set(data, 'daily', cache_ttl, **cache_params)
                    
                    logger.info(f"获取 {normalized_symbol} 数据成功: {len(data)} 条记录")
                    return data
                else:
                    logger.error(f"{normalized_symbol} 数据验证失败")
                    if fallback_to_test:
                        return self._get_test_data(normalized_symbol, start_date, end_date)
                    else:
                        return pd.DataFrame()
            else:
                if fallback_to_test:
                    return self._get_test_data(normalized_symbol, start_date, end_date)
                else:
                    return pd.DataFrame()
            
        except Exception as e:
            logger.error(f"获取 {normalized_symbol} 日线数据失败: {e}")
            if fallback_to_test:
                logger.warning(f"网络异常，回退到测试数据")
                return self._get_test_data(normalized_symbol, start_date, end_date)
            else:
                raise
    
    def _get_test_data(self, symbol: str, start_date: str, end_date: str) -> pd.DataFrame:
        """获取测试数据"""
        try:
            # 计算天数
            start_dt = datetime.strptime(start_date, '%Y-%m-%d')
            end_dt = datetime.strptime(end_date, '%Y-%m-%d')
            days = (end_dt - start_dt).days + 1
            
            if days <= 0:
                days = 100
            
            # 生成测试数据
            df = local_test_data.generate_stock_data(symbol, days)
            
            # 过滤日期范围
            mask = (df.index >= pd.Timestamp(start_date)) & (df.index <= pd.Timestamp(end_date))
            df = df[mask]
            
            logger.info(f"生成 {symbol} 测试数据: {len(df)} 条记录")
            return df
            
        except Exception as e:
            logger.error(f"生成测试数据失败: {e}")
            # 返回空DataFrame
            return pd.DataFrame()
    
    def _try_backup_data_source(self, symbol: str, start_date: str, 
                               end_date: str, adjust: str) -> pd.DataFrame:
        """尝试备用数据源"""
        backup_sources = {
            'tushare': TushareData(),
            'akshare': AKShareData()
        }
        
        # 移除当前数据源
        current_source = self.data_source
        if current_source in backup_sources:
            del backup_sources[current_source]
        
        for source_name, data_feed in backup_sources.items():
            try:
                logger.info(f"尝试使用备用数据源: {source_name}")
                data_feed.connect()
                data = data_feed.get_daily_data(symbol, start_date, end_date, adjust)
                data_feed.disconnect()
                
                if not data.empty and self.validate_data(data):
                    data = self.clean_data(data)
                    logger.info(f"备用数据源 {source_name} 获取成功")
                    return data
                    
            except Exception as e:
                logger.warning(f"备用数据源 {source_name} 失败: {e}")
                continue
        
        logger.error("所有数据源都失败了")
        return pd.DataFrame()
    
    def get_realtime_quote(
        self,
        symbol: str,
        use_cache: bool = True,
        cache_ttl: int = 30,
        fallback_to_test: bool = True
    ) -> Dict[str, Any]:
        """获取实时行情（带缓存）
        
        Args:
            symbol: 股票代码
            use_cache: 是否使用缓存
            cache_ttl: 缓存存活时间（秒），实时数据缓存时间较短
            fallback_to_test: 网络失败时是否回退到测试数据
            
        Returns:
            实时行情字典
        """
        # 标准化股票代码
        normalized_symbol, _ = stock_utils.normalize_symbol(symbol)
        
        cache_params = {'symbol': normalized_symbol}
        
        if use_cache and not self.use_test_data:
            cached_data = self.cache.get('realtime', **cache_params)
            if cached_data is not None:
                return cached_data
        
        # 如果使用测试数据
        if self.use_test_data:
            logger.info(f"使用测试数据模式获取 {normalized_symbol} 实时行情")
            return self._get_test_realtime_quote(normalized_symbol)
        
        data_feed = self.get_data_feed()
        if data_feed is None:
            if fallback_to_test:
                return self._get_test_realtime_quote(normalized_symbol)
            else:
                raise ValueError(f"未找到数据源: {self.data_source}")
        
        try:
            data = data_feed.get_realtime_quote(normalized_symbol)
            
            # 添加股票名称
            if data and 'name' not in data:
                data['name'] = stock_utils.get_stock_name(normalized_symbol)
            
            if use_cache and data:
                self.cache.set(data, 'realtime', cache_ttl, **cache_params)
            
            return data
            
        except Exception as e:
            logger.error(f"获取 {normalized_symbol} 实时行情失败: {e}")
            if fallback_to_test:
                return self._get_test_realtime_quote(normalized_symbol)
            else:
                return {}
    
    def _get_test_realtime_quote(self, symbol: str) -> Dict[str, Any]:
        """获取测试实时行情"""
        try:
            # 获取日线数据来模拟实时行情
            df = self._get_test_data(symbol, 
                                    (datetime.now() - timedelta(days=5)).strftime('%Y-%m-%d'),
                                    datetime.now().strftime('%Y-%m-%d'))
            
            if not df.empty:
                latest = df.iloc[-1]
                name = stock_utils.get_stock_name(symbol)
                
                quote = {
                    'symbol': symbol,
                    'name': name,
                    'price': float(latest['close']),
                    'change': float(latest['close'] - df.iloc[-2]['close'] if len(df) > 1 else 0),
                    'pct_change': float(latest['pct_chg'] if 'pct_chg' in latest else 0),
                    'volume': float(latest['volume']),
                    'amount': float(latest['amount']),
                    'high': float(latest['high']),
                    'low': float(latest['low']),
                    'open': float(latest['open']),
                    'pre_close': float(df.iloc[-2]['close'] if len(df) > 1 else latest['close']),
                    'timestamp': datetime.now().isoformat()
                }
                return quote
                
        except Exception as e:
            logger.error(f"生成测试实时行情失败: {e}")
        
        return {}
    
    def get_basic_info(self, symbol: str) -> Dict[str, Any]:
        """获取股票基本信息
        
        Args:
            symbol: 股票代码
            
        Returns:
            股票信息字典
        """
        # 标准化股票代码
        normalized_symbol, _ = stock_utils.normalize_symbol(symbol)
        
        if self.use_test_data:
            name = stock_utils.get_stock_name(normalized_symbol)
            return {
                'symbol': normalized_symbol,
                'name': name,
                'normalized_symbol': normalized_symbol
            }
        
        data_feed = self.get_data_feed()
        if data_feed is None:
            raise ValueError(f"未找到数据源: {self.data_source}")
        
        try:
            info = data_feed.get_basic_info(normalized_symbol)
            
            # 补充信息
            if info:
                info['normalized_symbol'] = normalized_symbol
                if 'name' not in info:
                    info['name'] = stock_utils.get_stock_name(normalized_symbol)
            
            return info
            
        except Exception as e:
            logger.error(f"获取 {normalized_symbol} 基本信息失败: {e}")
            return {}
    
    def get_multiple_stocks_data(
        self,
        symbols: List[str],
        start_date: str = None,
        end_date: str = None,
        adjust: str = "qfq",
        use_cache: bool = True
    ) -> Dict[str, pd.DataFrame]:
        """获取多个股票的数据
        
        Args:
            symbols: 股票代码列表
            start_date: 开始日期
            end_date: 结束日期
            adjust: 复权类型
            use_cache: 是否使用缓存
            
        Returns:
            字典，键为股票代码，值为DataFrame
        """
        result = {}
        
        for symbol in symbols:
            try:
                data = self.get_daily_data(
                    symbol, start_date, end_date, adjust, use_cache
                )
                normalized_symbol, _ = stock_utils.normalize_symbol(symbol)
                result[normalized_symbol] = data
            except Exception as e:
                logger.error(f"获取 {symbol} 数据失败: {e}")
                normalized_symbol, _ = stock_utils.normalize_symbol(symbol)
                result[normalized_symbol] = pd.DataFrame()
        
        return result
    
    def get_index_data(self, index_code: str = '000001.SH',
                      start_date: str = None, 
                      end_date: str = None) -> pd.DataFrame:
        """获取指数数据
        
        Args:
            index_code: 指数代码
            start_date: 开始日期
            end_date: 结束日期
            
        Returns:
            指数数据DataFrame
        """
        if self.use_test_data:
            # 使用测试数据
            if start_date is None:
                start_date = config_manager.get('data.start_date', '2020-01-01')
            if end_date is None:
                end_date = config_manager.get('data.end_date', datetime.now().strftime('%Y-%m-%d'))
            
            start_dt = datetime.strptime(start_date, '%Y-%m-%d')
            end_dt = datetime.strptime(end_date, '%Y-%m-%d')
            days = (end_dt - start_dt).days + 1
            
            if days <= 0:
                days = 100
            
            df = local_test_data.generate_index_data(index_code, days)
            
            # 过滤日期范围
            mask = (df.index >= pd.Timestamp(start_date)) & (df.index <= pd.Timestamp(end_date))
            df = df[mask]
            
            logger.info(f"生成 {index_code} 测试数据: {len(df)} 条记录")
            return df
        
        data_feed = self.get_data_feed()
        if data_feed is None:
            raise ValueError(f"未找到数据源: {self.data_source}")
        
        try:
            # 标准化指数代码
            normalized_index, _ = stock_utils.normalize_symbol(index_code)
            
            if start_date is None:
                start_date = config_manager.get('data.start_date', '2020-01-01')
            if end_date is None:
                end_date = config_manager.get('data.end_date', datetime.now().strftime('%Y-%m-%d'))
            
            # 尝试获取指数数据
            if hasattr(data_feed, 'get_index_data'):
                data = data_feed.get_index_data(normalized_index, start_date, end_date)
                if not data.empty:
                    return data
            
            # 如果数据源不支持指数数据，使用股票接口
            logger.info(f"数据源不支持指数数据，尝试使用股票接口获取 {normalized_index}")
            return self.get_daily_data(normalized_index, start_date, end_date, adjust=None)
            
        except Exception as e:
            logger.error(f"获取指数 {index_code} 数据失败: {e}")
            return pd.DataFrame()
    
    def validate_data(self, df: pd.DataFrame) -> bool:
        """验证数据质量
        
        Args:
            df: 要验证的DataFrame
            
        Returns:
            验证结果
        """
        if df.empty:
            logger.warning("数据为空")
            return False
        
        # 检查必需的列
        required_columns = ['open', 'high', 'low', 'close']
        missing_columns = [col for col in required_columns if col not in df.columns]
        if missing_columns:
            logger.warning(f"数据缺少必需的列: {missing_columns}")
            return False
        
        # 检查NaN值
        nan_count = df[required_columns].isna().sum().sum()
        if nan_count > 0:
            logger.warning(f"数据包含 {nan_count} 个NaN值")
        
        # 检查数据顺序（应该按时间升序）
        if not df.index.is_monotonic_increasing:
            logger.warning("数据索引不是单调递增的")
        
        # 检查价格合理性
        price_check = (df['close'] > 0).all() and (df['volume'] >= 0).all()
        if not price_check:
            logger.warning("数据包含不合理价格或成交量")
        
        return True
    
    def clean_data(self, df: pd.DataFrame) -> pd.DataFrame:
        """清理数据
        
        Args:
            df: 原始数据
            
        Returns:
            清理后的数据
        """
        # 确保索引是datetime
        if not isinstance(df.index, pd.DatetimeIndex):
            df.index = pd.to_datetime(df.index)
        
        # 按日期排序
        df = df.sort_index()
        
        # 移除重复索引
        df = df[~df.index.duplicated(keep='first')]
        
        # 处理NaN值
        numeric_cols = df.select_dtypes(include=['float64', 'int64']).columns
        df[numeric_cols] = df[numeric_cols].ffill().bfill()
        
        # 确保价格列是正值
        price_cols = ['open', 'high', 'low', 'close']
        for col in price_cols:
            if col in df.columns:
                df[col] = df[col].apply(lambda x: max(x, 0.01))  # 最小0.01元
        
        # 确保成交量非负
        if 'volume' in df.columns:
            df['volume'] = df['volume'].apply(lambda x: max(x, 0))
        
        return df
    
    def calculate_returns(self, df: pd.DataFrame, price_col: str = 'close') -> pd.DataFrame:
        """计算收益率相关指标
        
        Args:
            df: 价格数据
            price_col: 价格列名
            
        Returns:
            包含收益率指标的数据
        """
        result = df.copy()
        
        # 日收益率
        result['daily_return'] = result[price_col].pct_change()
        
        # 对数收益率
        result['log_return'] = np.log(result[price_col] / result[price_col].shift(1))
        
        # 累计收益率
        result['cumulative_return'] = (1 + result['daily_return']).cumprod() - 1
        
        # 滚动波动率（20日）
        result['volatility_20d'] = result['daily_return'].rolling(window=20).std() * np.sqrt(252)
        
        return result
    
    def get_cache_stats(self) -> Dict[str, Any]:
        """获取缓存统计信息"""
        return self.cache.get_stats()
    
    def clear_cache(self):
        """清理过期缓存"""
        self.cache.clear_expired()
    
    def close(self):
        """关闭数据管理器和所有数据源"""
        for name, feed in self.data_feeds.items():
            try:
                feed.disconnect()
                logger.info(f"数据源 '{name}' 已断开")
            except Exception as e:
                logger.error(f"断开数据源 '{name}' 失败: {e}")
        
        self.cache.close()
        logger.info("A股数据管理器已关闭")


# 创建全局A股数据管理器实例（强制使用测试数据模式）
astock_data_manager = AStockDataManager(use_test_data=True)